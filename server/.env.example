# Change this file to .env and changes your creanditials
NODE_ENV="development"
PORT=
SOCKET_PORT=

# Server Configuration
SERVER_URL=enter_your_server_url
DATABASE_URL=enter_your_db_url

# JWT Configuration
BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRE_IN=""
JWT_REFRESH_EXPIRE_IN=""

# Email Configuration
EMAIL=enter_your_email
APP_PASS=enter_your_app_pass
ADMIN_PASS=admin123

# Stripe Configuration
STRIPE_API_KEY=enter_your_stripe_api_key
STRIPE_API_SECRET=enter_your_stripe_api_secret

# Client Configuration
# Exact browser origin(s), comma-separated, e.g. https://example.com,https://admin.example.com
CLIENT_URL=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=
RESET_PASS_LINK=

# AWS Configuration
S3_BUCKET_ACCESS_KEY=enter_your_S3_BUCKET_ACCESS_KEY
S3_BUCKET_SECRET_ACCESS_KEY=enter_your_S3_BUCKET_SECRET_ACCESS_KEY
AWS_REGION=enter_your_AWS_REGION
AWS_BUCKET_NAME=enter_your_AWS_BUCKET_NAME

# RevenueCat Configuration
REVENUECAT_API_KEY=enter_your_revenuecat_api_key
REVENUECAT_WEBHOOK_SECRET=enter_your_revenuecat_webhook_secret
REVENUECAT_PROJECT_ID=enter_your_revenuecat_project_id

# Redis Configuration
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD="myStrongRedisPassword"