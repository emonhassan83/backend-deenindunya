{
  "name": "deenindunya-nodemailer",
  "version": "1.0.0",
  "description": "Standalone SMTP mail service for Deenindunya platform",
  "packageManager": "pnpm@10.34.3",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:watch": "tsc -w",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "keywords": [
    "nodemailer",
    "smtp",
    "email",
    "deenindunya"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "nodemailer": "^10.0.9"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.3.2"
  },
  "pnpm": {
    "overrides": {
      "qs@>=6.14.2 <=6.15.3": ">=6.16.0",
      "qs@>=2.2.5 <6.16.0": ">=6.16.0",
      "brace-expansion@<1.1.21": ">=1.1.21",
      "brace-expansion@<1.1.20": ">=1.1.20",
      "brace-expansion@<1.1.19": ">=1.1.19",
      "proxy-addr@>=1.1.0 <2.0.8": ">=2.0.8"
    }
  }
}
