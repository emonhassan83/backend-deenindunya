{
  "name": "deenindunya-server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start:prod": "node ./dist/server.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "lint": "eslint src --ignore-path .eslintignore --ext .js,.ts",
    "lint:fix": "npx eslint src --fix",
    "prettier": "prettier --ignore-path .gitignore --write \"./src/**/*.+(js|ts|json)\"",
    "prettier:fix": "npx prettier --write src",
    "test": "echo \"Error: no test specified\" && exit 1",
    "seed:quran": "ts-node src/app/seeder/surah.seed.ts",
    "seed:quran:prod": "node dist/seeder/surah.seed.js",
    "seed:quran:clean": "ts-node src/app/seeder/surah.seed.ts --clean",
    "seed:events": "ts-node src/app/seeder/events.seed.ts --current",
    "seed:events:prod": "node dist/app/seeder/events.seed.js --current",
    "seed:events:current": "ts-node src/app/seeder/events.seed.ts --current",
    "seed:events:year": "ts-node src/app/seeder/events.seed.ts --year",
    "seed:events:range": "ts-node src/app/seeder/events.seed.ts --range",
    "seed:events:fix": "ts-node src/app/seeder/events.seed.ts --fix",
    "seed:events:stats": "ts-node src/app/seeder/events.seed.ts --stats",
    "seed:events:delete": "ts-node src/app/seeder/events.seed.ts --delete 2024",
    "seed:events:delete-all": "ts-node src/app/seeder/events.seed.ts --delete --all",
    "seed:events:regenerate": "ts-node src/app/seeder/events.seed.ts --regenerate 1446",
    "seed:events:missing": "ts-node src/app/seeder/events.seed.ts --missing 1446",
    "seed:events:help": "ts-node src/app/seeder/events.seed.ts --help",
    "seed:lessons": "ts-node src/app/seeder/lesson.seeder.ts",
    "seed:lessons:prod": "node dist/app/seeder/lesson.seeder.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/lib-storage": "^3.901.0",
    "@google-cloud/storage": "^7.19.0",
    "@mapbox/node-pre-gyp": "^2.0.3",
    "axios": "^1.17.0",
    "bcrypt": "^6.0.0",
    "chalk": "^5.4.1",
    "cli-progress": "^3.12.0",
    "cloudinary": "^2.10.0",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "fs-extra": "^11.3.4",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "moment-hijri": "^3.0.0",
    "moment-timezone": "^0.6.1",
    "mongoose": "^9.6.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.10",
    "p-limit": "^7.3.0",
    "socket.io": "^4.8.3",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cli-progress": "^3.11.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/moment-hijri": "^2.1.4",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.2",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^17.6.0",
    "prettier": "^3.5.1",
    "stripe": "^22.2.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.24.1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "glob": "^11.0.0",
    "rimraf": "^5.0.0",
    "tar": "^7.5.11"
  }
}
